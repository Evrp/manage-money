# Server Configuration
PORT=3000
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/moneyflow?retryWrites=true&w=majority

# Security
JWT_SECRET=your_super_secret_jwt_key_here

# AI & Storage (Google Cloud)
GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key
GCS_BUCKET_NAME=your_gcs_bucket_name

LINE_CHANNEL_ID=your_line_channel_id
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token

# Used only when NODE_ENV=development to bypass LIFF for this existing user.
DEVELOPMENT_LINE_USER_ID=your_line_user_id

# Recurring bill reminders. All scheduled times are interpreted in this timezone.
REMINDER_TIMEZONE=Asia/Bangkok
# Default time for a bill if a client does not supply reminderTime.
# Vercel Cron checks every minute and sends at each bill's configured time.
REMINDER_RUN_TIMES=09:00
# A long random value shared only with Vercel Cron or your external cron provider.
CRON_SECRET=replace_with_a_long_random_secret

# CORS
FRONTEND_URL=https://wilhelmina-semidomestic-rosaria.ngrok-free.dev


#Fire Base
FIREBASE_STORAGE_BUCKET=private_key
FIREBASE_SERVICE_ACCOUNT={"type": "service_account", ...}
